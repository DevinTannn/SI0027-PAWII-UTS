            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Basis Data Lanjut\",\n  \"isbn\": \"{{isbn1}}\",\n  \"penulis\": [\n    \"Penulis Satu\",\n    \"Penulis Dua\"\n  ],\n  \"penerbit\": {\n    \"nama\": \"Penerbit Nusantara\",\n    \"tahun\": 2022\n  },\n  \"kategoriId\": \"{{kategoriId}}\",\n  \"stok\": 5\n}",
              "options": {

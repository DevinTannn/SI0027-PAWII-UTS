{
  "info": {
    "name": "SI0027 PAW II - UTS - Katalog Perpustakaan",
    "description": "Koleksi pengujian otomatis UTS PAW II (RESTful API CRUD Katalog Perpustakaan Digital Kampus).\n\nJalankan folder berurutan dari atas ke bawah (Collection Runner atau Newman) dengan environment 'UTS - Local'. Request saling berantai lewat variabel environment (kategoriId, bukuId, ...). Data unik dibuat otomatis pada request 1.1 sehingga collection dapat dijalankan berulang kali.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Kategori",
      "item": [
        {
          "name": "1.1 Buat kategori - sukses",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/kategori",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "kategori"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"{{kategoriNama}}\",\n  \"deskripsi\": \"Kategori untuk pengujian otomatis UTS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Data unik per run supaya collection bisa dijalankan berulang kali",
                  "const ts = Date.now();",
                  "pm.environment.set(\"kategoriNama\", \"Kategori UTS \" + ts);",
                  "const base = String(ts).slice(-10).padStart(10, '0');",
                  "pm.environment.set(\"isbn1\", \"978\" + base);",
                  "pm.environment.set(\"isbn2\", \"979\" + base);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Kategori tersimpan\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"_id\");",
                  "  pm.expect(body.nama).to.eql(pm.environment.get(\"kategoriNama\"));",
                  "  pm.environment.set(\"kategoriId\", body._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Buat kategori - nama duplikat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/kategori",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "kategori"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"{{kategoriNama}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Body memuat properti message\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"message\");",
                  "  pm.expect(body.message).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Daftar kategori",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/kategori",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "kategori"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Berupa array dan memuat kategori yang baru dibuat\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "  const ids = body.map(function (k) { return k._id; });",
                  "  pm.expect(ids).to.include(pm.environment.get(\"kategoriId\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

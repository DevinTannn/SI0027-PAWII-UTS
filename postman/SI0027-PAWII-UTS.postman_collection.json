                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Buku tersimpan lengkap (embedded & referencing)\", function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.property(\"_id\");",
                  "  pm.expect(b.judul).to.eql(\"Basis Data Lanjut\");",
                  "  pm.expect(b.isbn).to.eql(pm.environment.get(\"isbn1\"));",
                  "  pm.expect(b.penulis).to.eql([\"Penulis Satu\", \"Penulis Dua\"]);",
                  "  pm.expect(b.penerbit).to.include({ nama: \"Penerbit Nusantara\", tahun: 2022 });",
                  "  pm.expect(b.kategoriId).to.eql(pm.environment.get(\"kategoriId\"));",
                  "  pm.expect(b.stok).to.eql(5);",
                  "  pm.environment.set(\"bukuId\", b._id);",
                  "});"
                ]
              }
            }
          ]
        },
